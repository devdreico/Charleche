# Bodoque · recordatorios (Web Push)
# Genera tus claves con:  npm run vapid
# Si las dejas vacías, el server las crea y las guarda en server/data/vapid.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tatty@bodoque.app

# Puerto del server (app + API de notificaciones)
PORT=8787

# Si el frontend vive en otro dominio, permite el CORS de la API
ALLOW_ORIGIN=

# Desarrollo: a dónde manda Vite los /api
VITE_API_TARGET=http://localhost:8787
